// The assistant route on its own, for `wrangler dev` here. On the public site these bindings go into
// ~/Projects/site/wrangler.jsonc beside its own (see the header of assistant.js), with the key set as a secret:
// `wrangler secret put OPENROUTER_API_KEY` (locally: OPENROUTER_API_KEY in .dev.vars).
{
	"name": "surrogate-assistant",
	"main": "worker.js",
	"compatibility_date": "2026-11-04",
	"durable_objects": { "bindings": [{ "name": "ASSISTANT_LIMITS", "class_name": "AssistantLimits" }] },
	"migrations": [{ "tag": "assistant-limits", "new_sqlite_classes": ["AssistantLimits"] }],
	"vars": { "ASSISTANT_MODEL": "anthropic/claude-opus-5.5" }
}
